#!/usr/bin/with-contenv bash

CUSTOM_FILE="/custom-cont-init.d/Corefile"
TARGET_FILE="/config/coredns/Corefile"
BACKUP_FILE="/config/coredns/Corefile.bak"

if [ -f "$CUSTOM_FILE" ]; then
    if [ -f "$TARGET_FILE" ] && [ ! -f "$BACKUP_FILE" ]; then
        echo "[INFO] Backing up default Corefile to $BACKUP_FILE"
        cp -p "$TARGET_FILE" "$BACKUP_FILE"
    fi

    echo "[INFO] Applying custom Corefile to $TARGET_FILE"
    cp -f "$CUSTOM_FILE" "$TARGET_FILE"
else
    if [ -f "$BACKUP_FILE" ]; then
        echo "[INFO] Custom Corefile removed"
        echo "[INFO] Restoring default from $BACKUP_FILE"
        mv -f "$BACKUP_FILE" "$TARGET_FILE"
    else
        echo "[INFO] No custom Corefile found"
        echo "[INFO] Keeping default $TARGET_FILE"
    fi
fi
